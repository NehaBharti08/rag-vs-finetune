# ---------------------------------------------------------------------------
# rag-vs-finetune environment configuration
#
#   cp .env.example .env
#
# `.env` is gitignored and must never be committed.
#
# Deployment concerns (secrets, endpoints, log format) live HERE.
# Pipeline behaviour (chunk size, top-k, LoRA rank, thresholds) lives in
# committed YAML under config/ — so any benchmark number traces to an exact,
# diffable configuration. Same split as VidyaRAG, for the same reason.
# ---------------------------------------------------------------------------

# --- Generation / judging provider ------------------------------------------
# One of: ollama | openai
#
#   ollama  Free, fully local, no signup, no quota. The DEFAULT — the repo runs
#           end to end with zero API cost. Generator and judge must never be
#           Qwen-family: the student model is Qwen2.5-7B, so a Qwen generator
#           would distil its own family's style into the fine-tuned arm and a
#           Qwen judge would score its own family favourably.
#
#   openai  ~$2 total for the whole project (~$1.20 generation, ~$0.54 judging,
#           ~$0.06 embeddings). Buys a stronger generator, a defensible judge,
#           and bit-identical retrieval config with VidyaRAG — which is the
#           entire apples-to-apples claim.
RAGFT_PROVIDER=ollama

# --- Ollama (free path) ------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Non-Qwen by requirement, not preference. See above.
OLLAMA_GENERATION_MODEL=gemma4:e4b
OLLAMA_JUDGE_MODEL=gemma4:e4b
# Third family, used only for inter-judge agreement.
OLLAMA_JUDGE2_MODEL=llama3:8b

# --- OpenAI (optional ~$2 path) ---------------------------------------------
# Models match VidyaRAG's generation_model / grader_model / embedding_model
# exactly, so the retrieval arms are the same pipeline rather than a lookalike.
OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Embeddings (free path) --------------------------------------------------
# fastembed is already a transitive dep via qdrant-client[fastembed], so this
# adds no torch and no new stack. If you use this rather than OpenAI, VidyaRAG
# needs a matching `local` profile or the two retrieval arms are NOT identical.
FASTEMBED_MODEL=BAAI/bge-base-en-v1.5

# --- Qdrant ------------------------------------------------------------------
# Embedded mode: no server, no network hop. Corpus is ~6k chunks; VidyaRAG's
# store/client.py warns past ~20k points, so this is comfortable.
QDRANT_MODE=embedded
QDRANT_PATH=data/index
QDRANT_COLLECTION=ragft_indialaw_v1

# --- Experiment tracking -----------------------------------------------------
# Untracked runs do not exist. Free personal tier is sufficient.
WANDB_API_KEY=
WANDB_PROJECT=rag-vs-finetune
WANDB_ENTITY=

# --- Hugging Face ------------------------------------------------------------
# Needed only to PUSH the adapter and dataset in Phase 7. Reading Qwen2.5-7B
# needs no token — it is openly licensed and ungated.
HF_TOKEN=

# --- Observability -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console        # json | console
